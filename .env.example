# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to control the bot.
# Get your ID from @userinfobot on Telegram. Leave empty = anyone can use it (not recommended).
TELEGRAM_ALLOWED_USER_IDS=

OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

WEB_HOST=127.0.0.1
WEB_PORT=8787

SCAN_RATE_LIMIT=150
NUCLEI_SEVERITY=info,low,medium,high,critical
